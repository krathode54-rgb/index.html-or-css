/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Body */
body {
  font-family: Arial, sans-serif;
  background: linear-gradient(to right, #f9d423, #ff4e50);
  color: #333;
  min-height: 100vh;
}

/* Header */
header {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 20px;
}

/* Sections */
main {
  padding: 20px;
}

section {
  margin-bottom: 30px;
  background: #fff;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
}

h2 {
  margin-bottom: 15px;
  color: #444;
}

/* Form */
form {
  display: flex;
  gap: 10px;
}

form input, form button {
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 5px;
}

form button {
  background: #ff4e50;
  color: #fff;
  cursor: pointer;
  transition: 0.3s;
}

form button:hover {
  background: #d43f3a;
}

/* List */
ul {
  list-style: none;
}

ul li {
  padding: 10px;
  border-bottom: 1px solid #eee;
}

/* Footer */
footer {
  text-align: center;
  background: #333;
  color: #fff;
  padding: 15px;
}
